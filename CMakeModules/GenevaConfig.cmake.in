################################################################################
#
# CMake package configuration file for an installed Geneva library collection.
#
# This file is consumed via find_package(Geneva CONFIG REQUIRED). It re-finds
# the Boost dependency that Geneva exposes through its public interface and then
# pulls in the exported imported targets:
#
#   Geneva::common      - utilities (logging, threads, serialization helpers)
#   Geneva::dietrich    - plotting library (ROOT / gnuplot / matplotlib / data)
#   Geneva::hap         - random number generation
#   Geneva::courtier    - broker/consumer parallelization framework
#   Geneva::geneva      - core optimization library (links the others above)
#
# Linking Geneva::geneva transitively brings in the other three targets, the
# Geneva include directory, the required Boost components and the C++23
# requirement.
#
################################################################################

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Geneva exposes Boost through its public headers, so consumers need a
# compatible Boost. The component list mirrors GENEVA_BOOST_LIBS in
# CommonGenevaBuild.cmake (the test-only "test" component is not part of the
# installed interface).
find_dependency(Boost @GENEVA_MIN_BOOST_VERSION@ COMPONENTS
    filesystem
    json
    program_options
    regex
    serialization
    atomic
)

# If this Geneva was installed with testing support, the geneva library embeds
# Catch2-based test scaffolding and references Catch2 symbols. Such an install
# can only be consumed by linking Catch2 as well.
set(GENEVA_TESTING @GENEVA_INSTALLED_WITH_TESTING@)
if(GENEVA_TESTING)
    find_dependency(Catch2 3)
endif()

# Pull in the exported Geneva::* imported targets.
include("${CMAKE_CURRENT_LIST_DIR}/GenevaTargets.cmake")

# Individual-packaging helpers (GENEVA_ADD_INDIVIDUAL_MODULE / GENEVA_DECLARE_INDIVIDUAL) for a downstream
# project that packages its own optimization individuals as a compiled-in object library and/or a
# runtime-loadable module (like example 19 / example 10). The helpers need the Geneva header include
# directory; take it from the imported Geneva::geneva target's interface (the concrete installed include
# prefix). Boost's include dirs are added by the helpers at call time (find_dependency(Boost) above set
# Boost_INCLUDE_DIRS). This is the same GenevaIndividualModule.cmake the in-tree build uses.
get_target_property(GENEVA_INDIVIDUAL_INCLUDE_DIRS Geneva::geneva INTERFACE_INCLUDE_DIRECTORIES)
# The C++ standard Geneva was built with (a loadable module links no Geneva libs, so it must pin the
# standard on itself; the consumer project need not set CMAKE_CXX_STANDARD at all).
set(GENEVA_INDIVIDUAL_CXX_STANDARD @CMAKE_CXX_STANDARD@)
# The ABI-affecting compile options Geneva was built with (e.g. -DNDEBUG, which controls _GLIBCXX_ASSERTIONS).
# A loadable module inherits none of Geneva's flags, so applying these makes its module-compat fingerprint
# (abi_flags) match this Geneva regardless of the consumer's own build type / toolchain defaults.
set(GENEVA_INDIVIDUAL_ABI_OPTIONS @GENEVA_INDIVIDUAL_ABI_OPTIONS@)
include("${CMAKE_CURRENT_LIST_DIR}/GenevaIndividualModule.cmake")

# Convenience list of all imported targets, mirroring the legacy
# GENEVA_LIBRARIES variable (now holding imported targets instead of paths).
set(GENEVA_LIBRARIES
    Geneva::geneva
    Geneva::courtier
    Geneva::hap
    Geneva::dietrich
    Geneva::common
)

check_required_components(Geneva)
